---
const studentPhotos = [
  "/student1.webp",
  "/student2.webp",
  "/student3.webp",
  "/student4.webp",
  "/student5.webp",
  "/student6.webp",
];
---

<section class="hero">
  <!-- Background decoration -->
  <div class="hero-glow hero-glow-one"></div>
  <div class="hero-glow hero-glow-two"></div>

  <div class="hero-circle hero-circle-one"></div>
  <div class="hero-circle hero-circle-two"></div>
  <div class="hero-circle hero-circle-three"></div>

  <!-- Subtle drum silhouette -->
  <div class="hero-drum" aria-hidden="true">
    <div class="drum-shell">
      <div class="drum-head"></div>
      <div class="drum-rim"></div>
      <div class="drum-lug lug-one"></div>
      <div class="drum-lug lug-two"></div>
      <div class="drum-lug lug-three"></div>
      <div class="drum-lug lug-four"></div>
      <div class="drum-lug lug-five"></div>
      <div class="drum-lug lug-six"></div>
    </div>
  </div>

  <div class="hero-content">
    <div class="hero-text">
      <p class="eyebrow">
        Santiago High School
      </p>

      <h1>
        Indoor
        <span>Drumline</span>
      </h1>
    </div>

    <div class="photo-carousel">
      <div class="carousel-window">
        <div class="carousel-track">
          {studentPhotos.map((photo, index) => (
            <div class="carousel-slide">
              <img
                src={photo}
                alt={`Student photo ${index + 1}`}
                class="carousel-image"
              />
            </div>
          ))}
        </div>
      </div>

      <div class="carousel-controls">
        <button
          class="carousel-arrow"
          id="previous"
          aria-label="Previous photo"
        >
          ←
        </button>

        <div class="carousel-dots">
          {studentPhotos.map((_, index) => (
            <button
              class:list={["carousel-dot", { active: index === 0 }]}
              data-slide={index}
              aria-label={`Go to photo ${index + 1}`}
            ></button>
          ))}
        </div>

        <button
          class="carousel-arrow"
          id="next"
          aria-label="Next photo"
        >
          →
        </button>
      </div>
    </div>
  </div>

  <!-- Hero wave transition -->
  <div class="wave hero-wave" aria-hidden="true">
    <svg
      viewBox="0 0 1600 150"
      preserveAspectRatio="none"
    >
      <g class="wave-layer wave-deep-layer">
        <path
          class="wave-deep"
          d="M0 58
             C180 104 350 102 520 62
             C700 20 860 20 1040 62
             C1220 104 1400 98 1600 48
             L1600 150
             L0 150
             Z"
        />
      </g>

      <g class="wave-layer wave-back-layer">
        <path
          class="wave-back"
          d="M0 76
             C190 118 360 114 540 74
             C720 34 860 35 1040 72
             C1220 112 1400 106 1600 60
             L1600 150
             L0 150
             Z"
        />
      </g>

      <g class="wave-layer wave-mid-layer">
        <path
          class="wave-mid"
          d="M0 92
             C180 130 350 127 530 93
             C710 58 860 58 1040 92
             C1220 127 1400 120 1600 76
             L1600 150
             L0 150
             Z"
        />
      </g>

      <g class="wave-layer wave-front-layer">
        <path
          class="wave-front"
          d="M0 108
             C190 140 360 138 540 108
             C720 78 860 76 1040 108
             C1220 138 1400 132 1600 94
             L1600 150
             L0 150
             Z"
        />
      </g>
    </svg>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero) {
    const waveContainer = hero.querySelector<HTMLElement>(".hero-wave");
    const deepLayer = hero.querySelector<SVGGElement>(".wave-deep-layer");
    const backLayer = hero.querySelector<SVGGElement>(".wave-back-layer");
    const midLayer = hero.querySelector<SVGGElement>(".wave-mid-layer");
    const frontLayer = hero.querySelector<SVGGElement>(".wave-front-layer");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let ticking = false;
    let animationFrame = 0;

    let currentDeep = 0;
    let currentBack = 0;
    let currentMid = 0;
    let currentFront = 0;
    let currentReveal = 0;

    let targetDeep = 0;
    let targetBack = 0;
    let targetMid = 0;
    let targetFront = 0;
    let targetReveal = 0;

    const setLayerTransform = (layer: SVGGElement | null, x: number) => {
      if (layer) {
        layer.setAttribute("transform", `translate(${x.toFixed(2)} 0)`);
      }
    };

    const animateWaves = () => {
      const easing = 0.075;

      currentDeep += (targetDeep - currentDeep) * easing;
      currentBack += (targetBack - currentBack) * easing;
      currentMid += (targetMid - currentMid) * easing;
      currentFront += (targetFront - currentFront) * easing;
      currentReveal += (targetReveal - currentReveal) * easing;

      setLayerTransform(deepLayer, currentDeep);
      setLayerTransform(backLayer, currentBack);
      setLayerTransform(midLayer, currentMid);
      setLayerTransform(frontLayer, currentFront);

      if (waveContainer) {
        const waveHeight = waveContainer.getBoundingClientRect().height;
        const reveal = Math.max(0, waveHeight - currentReveal);

        waveContainer.style.setProperty(
          "--wave-reveal-offset",
          `${reveal}px`
        );
      }

      const stillMoving =
        Math.abs(targetDeep - currentDeep) > 0.05 ||
        Math.abs(targetBack - currentBack) > 0.05 ||
        Math.abs(targetMid - currentMid) > 0.05 ||
        Math.abs(targetFront - currentFront) > 0.05 ||
        Math.abs(targetReveal - currentReveal) > 0.05;

      if (stillMoving) {
        animationFrame = window.requestAnimationFrame(animateWaves);
      } else {
        animationFrame = 0;
      }
    };

    const updateWaves = () => {
      const scrollY = window.scrollY;
      const waveHeight = waveContainer?.getBoundingClientRect().height ?? 150;

      targetReveal = Math.min(scrollY, waveHeight);

      if (!reduceMotion) {
        const motion = scrollY * 0.0012;

        targetDeep = Math.sin(motion) * 52;
        targetBack = Math.sin(motion + 0.65) * 40;
        targetMid = Math.sin(motion + 1.25) * 28;
        targetFront = Math.sin(motion + 1.8) * 18;
      } else {
        targetDeep = 0;
        targetBack = 0;
        targetMid = 0;
        targetFront = 0;
      }

      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(animateWaves);
      }

      ticking = false;
    };

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateWaves);
        ticking = true;
      }
    };

    updateWaves();

    window.addEventListener("scroll", handleScroll, {
      passive: true
    });

    window.addEventListener("beforeunload", () => {
      if (animationFrame) {
        window.cancelAnimationFrame(animationFrame);
      }
    });
  }
</script>
