---
import { staff } from "../data/siteData";
---

<section id="staff" class="section staff-section">
  <div class="section-container">
    <div class="section-heading">
      <h2>
        Staff
      </h2>

      <p>
        DESCRIPTION
      </p>
    </div>

    <div class="staff-grid">
      {staff.map((member, index) => (
        <article class="staff-card">
          <div class="staff-image">
            <img
              src={`/staff${index + 1}.png`}
              alt={`${member.name} staff photo`}
              class="staff-photo"
            />
          </div>

          <div class="staff-info">
            <p class="staff-role">
              {member.role}
            </p>

            <h3>
              {member.name}
            </h3>

            <p class="staff-description">
              {member.desc}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
