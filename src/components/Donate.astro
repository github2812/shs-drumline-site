---
import {
  donationUrl,
  fundraisingVideoUrl,
} from "../data/siteData";
---

<section id="donate" class="section donate-section">
  <div class="section-container donate-layout">
    <div class="video-card">
      <a
        href={fundraisingVideoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="video-link"
      >
        <div class="video-placeholder">
          <div class="placeholder-content">
            <span class="placeholder-icon">
              ▶
            </span>

            <span>
              Fundraising Video
            </span>
          </div>
        </div>

        <div class="video-play">
          ▶
        </div>
      </a>
    </div>

    <div class="donate-text">
      <h2>
        Donate
      </h2>

      <p>
        Our students commit themselves to months of hard work, creativity, and discipline to achieve exellence in percussion performance. Your generous donation could provide:
      </p>
      <p>• Instruments, equipment, and up-to-date audio technology. </p>
      <p>• Props, uniforms, and design elements. </p>
      <p>• Tuition assistance so no students are turned away due to financial hardship. </p>
      <p>All donations go directly towards helping the students have an amazing, educational season!</p>

      <a
        href={donationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="gold-button"
      >
        Donate
      </a>
    </div>
  </div>

  <div class="wave donate-wave">
    <svg
      viewBox="0 0 1440 150"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
    <path
    class="wave-front"
    d="M0 72
       C180 115 330 115 500 78
       C680 40 820 40 980 78
       C1160 118 1290 112 1440 68
       L1440 150
       L0 150
       Z"
  />
    </svg>
  </div>
</section>
