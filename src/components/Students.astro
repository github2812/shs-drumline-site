---
import {
  instagramBattery,
  instagramFrontEnsemble,
} from "../data/siteData";
---

<section id="students" class="section students-section">
  <div class="section-container">
    <div class="section-heading">
      <h2>
        Students
      </h2>

      <p>
        DESCRIPTION
      </p>
    </div>

    <div class="instagram-links">
      <a
        href={instagramBattery}
        target="_blank"
        rel="noopener noreferrer"
        class="instagram-card"
      >
        <div class="instagram-icon">
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              cx="12"
              cy="12"
              r="4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              cx="17.5"
              cy="6.5"
              r="1"
              fill="currentColor"
            />
          </svg>
        </div>

        <div class="instagram-text">
          <span>
            Battery
          </span>

          <strong>
            Follow on Instagram →
          </strong>
        </div>
      </a>

      <a
        href={instagramFrontEnsemble}
        target="_blank"
        rel="noopener noreferrer"
        class="instagram-card"
      >
        <div class="instagram-icon">
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              cx="12"
              cy="12"
              r="4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              cx="17.5"
              cy="6.5"
              r="1"
              fill="currentColor"
            />
          </svg>
        </div>

        <div class="instagram-text">
          <span>
            Front Ensemble
          </span>

          <strong>
            Follow on Instagram →
          </strong>
        </div>
      </a>
    </div>
  </div>

  <div class="wave students-wave">
    <svg
      viewBox="0 0 1440 150"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
      class="wave-front"
      d="M0 72
        C180 115 330 115 500 78
        C680 40 820 40 980 78
        C1160 118 1290 112 1440 68
        L1440 150
        L0 150
        Z"
      />
    </svg>
  </div>
</section>
